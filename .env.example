POSTGRES_USER=hoe
POSTGRES_PASSWORD=hoe
POSTGRES_DB=hoe
DATABASE_URL=postgresql://hoe:hoe@db:5432/hoe
POE_NINJA_LEAGUE=Keepers
LUAJIT_POOL_SIZE=2

# ── M7: LLM explanations ────────────────────────────────────────────────────
# OpenAI API key — leave empty to disable LLM and use template explanations.
OPENAI_API_KEY=

# Per-call timeout (seconds) before falling back to template (default: 8).
# LLM_TIMEOUT_SECONDS=8

# Daily spend cap in USD; 0 = unlimited (default: 5.0).
# LLM_DAILY_SPEND_CAP_USD=5.0

# ── M6: Production hardening ────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
# Example: https://home-of-exile.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Per-IP rate limit for POST /api/v1/analyze (requests per hour)
RATE_LIMIT_PER_HOUR=10

# Runtime environment: development | production
ENVIRONMENT=development

# ── Frontend (Vite build-time env) ──────────────────────────────────────────
# Base URL of the backend API (no trailing slash)
# Set in Vercel project settings; locally uses Vite proxy (empty string)
VITE_API_URL=

